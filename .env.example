APP_ENV=production
SERVICE_VERSION=0.2.0
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=sqldemo3
MYSQL_USER=power_ops_reader
MYSQL_PASSWORD=replace_me
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_STATEMENT_TIMEOUT_MS=25000
MYSQL_POOL_SIZE=8
MYSQL_POOL_WAIT_SECONDS=3
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_REQUIRE_AUTH=true
MCP_AUTH_TOKEN=replace_me
MCP_AUTH_ISSUER_URL=http://power-ops-mcp:8000
MCP_PUBLIC_URL=http://power-ops-mcp:8000
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,host.docker.internal:*,power-ops-mcp:*
MCP_ALLOWED_ORIGINS=
MCP_MAX_REQUEST_BODY_SIZE=1048576
MCP_MAX_CONCURRENT_QUERIES=8
MCP_FUZZY_MIN_LENGTH=2
LOG_LEVEL=INFO
