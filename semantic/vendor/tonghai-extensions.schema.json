{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonghai.local/schemas/power-ops-extensions.json",
  "type": "object",
  "required": ["power_ops", "mcp"],
  "properties": {
    "power_ops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "closed_statuses", "fast_sources", "equipment_sources", "dimensions", "data_boundaries"],
      "properties": {
        "schema_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"},
        "closed_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fast_sources": {
          "type": "object", "additionalProperties": false, "required": ["defect", "workorder"],
          "properties": {"defect": {"type": "string"}, "workorder": {"type": "string"}}
        },
        "equipment_sources": {
          "type": "object", "additionalProperties": false, "required": ["defect", "workorder"],
          "properties": {"defect": {"type": "string"}, "workorder": {"type": "string"}}
        },
        "dimensions": {
          "type": "object", "additionalProperties": false, "required": ["defect", "workorder", "failure"],
          "properties": {
            "defect": {"$ref": "#/$defs/stringMap"},
            "workorder": {"$ref": "#/$defs/stringMap"},
            "failure": {"$ref": "#/$defs/stringMap"}
          }
        },
        "data_boundaries": {
          "type": "object", "additionalProperties": false, "required": ["defect", "workorder"],
          "properties": {"defect": {"type": "string", "minLength": 1}, "workorder": {"type": "string", "minLength": 1}}
        }
      }
    },
    "mcp": {
      "type": "object", "additionalProperties": false, "required": ["tools"],
      "properties": {
        "tools": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["label", "domains", "intents"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "intents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stringMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
